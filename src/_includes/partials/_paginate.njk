{% set previousPost = collections.post | getPreviousCollectionItem(page) %}
{% set nextPost = collections.post | getNextCollectionItem(page) %}
<div
  class="paginate border-y border-slate-600 py-5 flex justify-evenly items-center"
>
  {%
    if
    previousPost
  %}
    <p>
      Previous:
      <a href="{{ previousPost.url }}" class="hover:text-cyan-600"
        >{{ previousPost.data.title }}</a
      >
    </p>
  {% endif %}
  <br />
  {% if nextPost %}
    <p>
      Next:
      <a href="{{ nextPost.url }}" class="hover:text-cyan-600"
        >{{ nextPost.data.title }}</a
      >
    </p>
  {% endif %}
</div>
