---
layout: base
title: Blog
tags: page
order: 3
---

<section class="">
  {% headers "Blog" %}
  <ul class="blog-list mt-5 space-y-5">
    {% for post in collections.post | reverse %}
      <li class="blog-list-item shadow-lg bg-white p-4">
        <a
          href="{{ post.url }}"
          class="block font-semibold text-lg hover:text-cyan-800 blog-link"
          >{{ post.data.title }}</a
        >
        <small class="blog-date">{{ post.date | postDate }}</small>
      </li>
    {% endfor %}
  </ul>
</section>
